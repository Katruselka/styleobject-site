---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOOKS } from '../../data/looks.js';

export async function getStaticPaths() {
  return LOOKS.map(look => ({
    params: { slug: look.slug },
    props: { look }
  }));
}

const { look } = Astro.props;
const base = import.meta.env.BASE_URL;

const related = LOOKS.filter(l => l.category === look.category && l.slug !== look.slug).slice(0, 3);
const otherRelated = related.length < 2 
  ? LOOKS.filter(l => l.slug !== look.slug && !related.find(r => r.slug === l.slug)).slice(0, 3 - related.length)
  : [];
const showRelated = [...related, ...otherRelated].slice(0, 3);
---
<BaseLayout title={look.title} description={`${look.productName} — ${look.price} on Amazon. ${look.story.slice(0, 120)}`} activeCategory={look.category}>
<style>
  .breadcrumb { padding: 20px 0 0; font-size: 12px; color: #8a7464; }
  .breadcrumb a { color: #8a7464; text-decoration: none; }
  .breadcrumb a:hover { color: #2a2420; }
  .breadcrumb span { margin: 0 8px; opacity: 0.5; }
  .look-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; padding: 48px 0 80px; align-items: start; }
  .hero-image-wrap { width: 100%; height: 680px; overflow: hidden; border-radius: 4px; background: #f5f0e8; position: sticky; top: 88px; }
  .hero-image-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .hero-content { padding-top: 8px; }
  .hero-category { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: #8a7464; margin-bottom: 20px; }
  .hero-title { font-family: 'Fraunces', serif; font-size: clamp(26px, 3.5vw, 48px); font-weight: 400; line-height: 1.1; letter-spacing: -1px; margin-bottom: 28px; }
  .hero-story { font-size: 15px; line-height: 1.85; color: #3a312a; margin-bottom: 36px; }
  .product-card { border: 1px solid rgba(42,36,32,0.15); border-radius: 4px; overflow: hidden; }
  .product-image { width: 100%; height: 280px; overflow: hidden; background: #f5f0e8; }
  .product-image img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .product-info { padding: 22px; }
  .product-label { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #8a7464; margin-bottom: 6px; }
  .product-name { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 400; margin-bottom: 8px; }
  .product-desc { font-size: 13px; color: #5c4a3a; margin-bottom: 14px; line-height: 1.6; }
  .product-price { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 400; margin-bottom: 18px; }
  .price-original { text-decoration: line-through; color: #8a7464; font-size: 16px; margin-right: 8px; }
  .price-sale { color: #2a2420; }
  .amazon-btn { display: block; padding: 15px 24px; background: #2a2420; color: #faf6ee; text-decoration: none; text-align: center; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; transition: background 0.2s; border-radius: 2px; }
  .amazon-btn:hover { background: #5c4a3a; }
  .tips-section { padding: 72px 0; border-top: 1px solid rgba(42,36,32,0.1); }
  .section-eyebrow { font-size: 11px; letter-spacing: 4px; text-transform: uppercase; color: #8a7464; margin-bottom: 10px; }
  .section-heading { font-family: 'Fraunces', serif; font-size: clamp(26px, 4vw, 38px); font-weight: 400; letter-spacing: -0.5px; margin-bottom: 40px; }
  .section-heading em { font-style: italic; color: #5c4a3a; }
  .tips-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .tip-card { padding: 28px; background: #f5f0e8; border-radius: 4px; }
  .tip-label { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #8a7464; margin-bottom: 10px; }
  .tip-text { font-size: 14px; line-height: 1.75; color: #3a312a; }
  .more-section { padding: 72px 0; background: #f5f0e8; }
  .more-section .section-eyebrow, .more-section .section-heading { text-align: center; }
  .more-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; max-width: 800px; margin: 0 auto; }
  .more-card { text-decoration: none; color: inherit; display: block; transition: transform 0.3s; }
  .more-card:hover { transform: translateY(-4px); }
  .more-card-image { width: 100%; height: 320px; overflow: hidden; border-radius: 4px; background: #faf6ee; margin-bottom: 12px; }
  .more-card-image img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; transition: transform 0.6s; }
  .more-card:hover img { transform: scale(1.05); }
  .more-card-title { font-family: 'Fraunces', serif; font-size: 16px; font-weight: 400; line-height: 1.3; }
  @media (max-width: 768px) {
    .look-hero { grid-template-columns: 1fr; gap: 28px; padding: 32px 0 60px; }
    .hero-image-wrap { position: static; height: 480px; }
  }
</style>

<div class="container">
  <div class="breadcrumb">
    <a href={`${base}`}>Home</a>
    <span>›</span>
    <a href={`${base}looks/`}>All Looks</a>
    <span>›</span>
    {look.title}
  </div>

  <div class="look-hero">
    <div class="hero-image-wrap">
      <img src={`${base}${look.heroImage.replace(/^\//, '')}`} alt={look.title}>
    </div>
    <div class="hero-content">
      <p class="hero-category">{look.category}</p>
      <h1 class="hero-title">{look.title}</h1>
      <p class="hero-story">{look.story}</p>
      <div class="product-card">
        <div class="product-image">
          <img src={`${base}${look.productImage.replace(/^\//, '')}`} alt={look.productName}>
        </div>
        <div class="product-info">
          <p class="product-label">The Item</p>
          <div class="product-name">{look.productName}</div>
          <p class="product-desc">{look.productDesc}</p>
          <div class="product-price">
            {look.priceOriginal && <span class="price-original">{look.priceOriginal}</span>}
            <span class="price-sale">{look.price}</span>
          </div>
          <a href={look.amazon} class="amazon-btn" target="_blank" rel="nofollow sponsored">Shop on Amazon →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<section class="tips-section">
  <div class="container">
    <p class="section-eyebrow">Styling Notes</p>
    <h2 class="section-heading">How to <em>wear it</em></h2>
    <div class="tips-grid">
      {look.tips.map(tip => (
        <div class="tip-card">
          <div class="tip-label">{tip.label}</div>
          <p class="tip-text">{tip.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{showRelated.length > 0 && (
  <section class="more-section">
    <div class="container">
      <p class="section-eyebrow">More Looks</p>
      <h2 class="section-heading">You Might Also <em>Like</em></h2>
      <div class="more-grid">
        {showRelated.map(rel => (
          <a href={`${base}looks/${rel.slug}/`} class="more-card">
            <div class="more-card-image">
              <img src={`${base}${rel.heroImage.replace(/^\//, '')}`} alt={rel.title} loading="lazy">
            </div>
            <div class="more-card-title">{rel.title}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
</BaseLayout>
