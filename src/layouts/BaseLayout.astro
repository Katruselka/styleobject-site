---
const { title, description, activePage = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — STYLE OBJECT</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={Astro.url.href}>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JHWC41ZE4V"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JHWC41ZE4V');
  </script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #faf6ee; color: #2a2420; line-height: 1.6; font-weight: 300; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .header { padding: 18px 0; background: #faf6ee; position: sticky; top: 0; z-index: 200; border-bottom: 1px solid rgba(42,36,32,0.08); }
    .header-inner { display: flex; justify-content: space-between; align-items: center; }
    .logo { font-family: 'Fraunces', serif; font-size: 20px; font-weight: 400; letter-spacing: 4px; color: #2a2420; text-decoration: none; }
    .menu-btn { background: none; border: none; cursor: pointer; padding: 6px; display: flex; flex-direction: column; gap: 5px; }
    .menu-btn span { display: block; width: 22px; height: 1.5px; background: #2a2420; transition: all 0.3s; }
    .menu-btn.open span:nth-child(1) { transform: rotate(45deg) translate(4px, 4px); }
    .menu-btn.open span:nth-child(2) { opacity: 0; }
    .menu-btn.open span:nth-child(3) { transform: rotate(-45deg) translate(4px, -4px); }
    .sidebar-overlay { position: fixed; inset: 0; background: rgba(42,36,32,0.4); z-index: 300; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
    .sidebar-overlay.open { opacity: 1; pointer-events: all; }
    .sidebar { position: fixed; top: 0; right: -340px; width: 320px; height: 100vh; background: #faf6ee; z-index: 400; transition: right 0.35s ease; padding: 32px 0; display: flex; flex-direction: column; }
    .sidebar.open { right: 0; }
    .sidebar-header { display: flex; justify-content: space-between; align-items: center; padding: 0 32px 28px; border-bottom: 1px solid rgba(42,36,32,0.1); }
    .sidebar-logo { font-family: 'Fraunces', serif; font-size: 16px; letter-spacing: 3px; color: #2a2420; }
    .sidebar-close { background: none; border: none; cursor: pointer; font-size: 22px; color: #5c4a3a; line-height: 1; }
    .sidebar-nav { padding: 32px; flex: 1; }
    .sidebar-section { margin-bottom: 32px; }
    .sidebar-section-label { font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: #8a7464; margin-bottom: 14px; }
    .sidebar-nav a { display: block; font-family: 'Fraunces', serif; font-size: 22px; font-weight: 400; color: #2a2420; text-decoration: none; margin-bottom: 12px; letter-spacing: -0.3px; transition: color 0.2s; }
    .sidebar-nav a:hover { color: #5c4a3a; }
    .sidebar-sub a { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 300; letter-spacing: 1px; text-transform: uppercase; color: #5c4a3a; margin-bottom: 8px; }
    .sidebar-footer { padding: 24px 32px 0; border-top: 1px solid rgba(42,36,32,0.1); font-size: 11px; color: #8a7464; font-style: italic; }
    .disclosure { padding: 24px; text-align: center; font-size: 11px; color: #8a7464; font-style: italic; border-top: 1px solid rgba(42,36,32,0.08); }
    .footer { padding: 48px 0 32px; text-align: center; background: #2a2420; color: #faf6ee; }
    .footer-logo { font-family: 'Fraunces', serif; font-size: 20px; letter-spacing: 4px; margin-bottom: 20px; }
    .footer-links { display: flex; gap: 20px; justify-content: center; margin-bottom: 24px; flex-wrap: wrap; }
    .footer-links a { color: #faf6ee; text-decoration: none; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; opacity: 0.6; transition: opacity 0.2s; }
    .footer-links a:hover { opacity: 1; }
    .footer-copy { font-size: 10px; color: #8a7464; letter-spacing: 1px; }
  </style>
</head>
<body>

<div class="sidebar-overlay" id="overlay"></div>

<div class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <span class="sidebar-logo">STYLE · OBJECT</span>
    <button class="sidebar-close" id="closeBtn">✕</button>
  </div>
  <nav class="sidebar-nav">
    <div class="sidebar-section">
      <div class="sidebar-section-label">Shop</div>
      <a href={`${base}looks/`}>Shop the Edit</a>
      <div class="sidebar-sub">
        <a href={`${base}looks/?cat=bags`}>Bags</a>
        <a href={`${base}looks/?cat=shoes`}>Shoes</a>
        <a href={`${base}looks/?cat=dresses`}>Dresses</a>
        <a href={`${base}looks/?cat=accessories`}>Accessories</a>
      </div>
    </div>
    <div class="sidebar-section">
      <div class="sidebar-section-label">Discover</div>
      <a href={`${base}looks/`}>New In</a>
      <a href={`${base}looks/`}>Collections</a>
      <a href={`${base}looks/`}>Style Tips</a>
    </div>
    <div class="sidebar-section">
      <div class="sidebar-section-label">Info</div>
      <a href={`${base}looks/`}>About</a>
    </div>
  </nav>
  <div class="sidebar-footer">
    As an Amazon Associate I earn from qualifying purchases.
  </div>
</div>

<header class="header">
  <div class="container header-inner">
    <a href={`${base}`} class="logo">STYLE · OBJECT</a>
    <button class="menu-btn" id="menuBtn" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<slot />

<div class="disclosure">
  <div class="container">
    This page contains affiliate links. As an Amazon Associate I earn from qualifying purchases.
  </div>
</div>

<footer class="footer">
  <div class="container">
    <div class="footer-logo">STYLE · OBJECT</div>
    <div class="footer-links">
      <a href={`${base}looks/`}>Shop the Edit</a>
      <a href={`${base}looks/`}>Collections</a>
      <a href={`${base}looks/`}>Style Tips</a>
      <a href={`${base}looks/`}>About</a>
    </div>
    <div class="footer-copy">© 2026 Style Object. All rights reserved.</div>
  </div>
</footer>

<script>
  const menuBtn = document.getElementById('menuBtn');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('overlay');
  const closeBtn = document.getElementById('closeBtn');
  function openMenu() { sidebar.classList.add('open'); overlay.classList.add('open'); menuBtn.classList.add('open'); document.body.style.overflow = 'hidden'; }
  function closeMenu() { sidebar.classList.remove('open'); overlay.classList.remove('open'); menuBtn.classList.remove('open'); document.body.style.overflow = ''; }
  menuBtn.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);
  overlay.addEventListener('click', closeMenu);
</script>
</body>
</html>
