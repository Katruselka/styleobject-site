Вот полный `src/pages/index.astro`:

```astro
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LOOKS } from '../data/looks.js';
const base = import.meta.env.BASE_URL;
const newIn = LOOKS.slice(-3).reverse();
---
<BaseLayout title="Style Object — Amazon Fashion Finds" description="Looks expensive. Costs less. Curated quiet luxury outfits, bags and shoes from Amazon.">
<style>
  /* HERO */
  .hero { position: relative; height: 600px; min-height: 500px; overflow: hidden; }
  .hero-img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; display: block; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(42,36,32,0.05) 0%, rgba(42,36,32,0.55) 100%); }
  .hero-content { position: absolute; bottom: 56px; left: 0; right: 0; text-align: center; color: #faf6ee; padding: 0 24px; }
  .hero-eyebrow { font-size: 11px; letter-spacing: 5px; text-transform: uppercase; opacity: 0.85; margin-bottom: 14px; }
  .hero-title { font-family: 'Fraunces', serif; font-size: clamp(38px, 6vw, 72px); font-weight: 400; letter-spacing: -2px; line-height: 1; margin-bottom: 14px; }
  .hero-title em { font-style: italic; }
  .hero-sub { font-size: 15px; opacity: 0.85; margin-bottom: 32px; line-height: 1.5; max-width: 480px; margin-left: auto; margin-right: auto; }
  .hero-btn { display: inline-block; padding: 14px 40px; border: 1.5px solid #faf6ee; color: #faf6ee; text-decoration: none; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; transition: all 0.25s; border-radius: 2px; }
  .hero-btn:hover { background: #faf6ee; color: #2a2420; }
  .hero-trust { font-size: 11px; opacity: 0.65; margin-top: 16px; letter-spacing: 1px; }

  /* TRUST BAR */
  .trust-bar { background: #2a2420; color: #faf6ee; padding: 14px 0; }
  .trust-bar-inner { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; }
  .trust-bar span { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; opacity: 0.8; }

  /* SECTIONS */
  .section { padding: 72px 0; }
  .section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 36px; }
  .section-eyebrow { font-size: 10px; letter-spacing: 4px; text-transform: uppercase; color: #8a7464; margin-bottom: 8px; }
  .section-title { font-family: 'Fraunces', serif; font-size: clamp(26px, 3.5vw, 38px); font-weight: 400; letter-spacing: -0.5px; }
  .section-title em { font-style: italic; color: #5c4a3a; }
  .section-link { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #5c4a3a; text-decoration: none; border-bottom: 1px solid #8a7464; padding-bottom: 2px; white-space: nowrap; }
  .section-link:hover { color: #2a2420; border-color: #2a2420; }

  /* CARDS */
  .looks-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 32px; }
  .look-card { display: block; text-decoration: none; color: inherit; }
  .look-card-img { aspect-ratio: 4/5; overflow: hidden; border-radius: 6px; background: #f5f0e8; margin-bottom: 14px; display: block; }
  .look-card-img img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; transition: transform 0.6s; }
  .look-card-img:hover img { transform: scale(1.04); }
  .look-card-cat { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: #8a7464; margin-bottom: 5px; }
  .look-card-title { font-family: 'Fraunces', serif; font-size: 16px; font-weight: 400; line-height: 1.3; margin-bottom: 5px; color: #2a2420; display: block; text-decoration: none; }
  .look-card-title:hover { color: #5c4a3a; }
  .look-card-price { font-size: 14px; color: #5c4a3a; margin-bottom: 12px; }
  .look-card-btn { display: block; padding: 10px; background: #2a2420; color: #faf6ee; text-align: center; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; border-radius: 4px; text-decoration: none; transition: background 0.2s; }
  .look-card-btn:hover { background: #5c4a3a; }

  /* BANNER */
  .banner { border-radius: 8px; overflow: hidden; position: relative; height: 440px; margin-bottom: 72px; }
  .banner img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .banner-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(42,36,32,0.72) 0%, rgba(42,36,32,0.1) 60%); }
  .banner-content { position: absolute; top: 50%; left: 48px; transform: translateY(-50%); color: #faf6ee; max-width: 380px; }
  .banner-eyebrow { font-size: 10px; letter-spacing: 4px; text-transform: uppercase; opacity: 0.8; margin-bottom: 12px; }
  .banner-title { font-family: 'Fraunces', serif; font-size: clamp(26px, 3.5vw, 42px); font-weight: 400; letter-spacing: -1px; line-height: 1.1; margin-bottom: 10px; }
  .banner-title em { font-style: italic; }
  .banner-sub { font-size: 14px; opacity: 0.8; margin-bottom: 24px; line-height: 1.6; }
  .banner-btn { display: inline-block; padding: 11px 28px; border: 1.5px solid #faf6ee; color: #faf6ee; text-decoration: none; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; transition: all 0.25s; border-radius: 3px; }
  .banner-btn:hover { background: #faf6ee; color: #2a2420; }

  /* STYLE TIPS */
  .tips-section { background: #f5f0e8; padding: 72px 0; }
  .tips-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .tip-card { background: #eee8de; border-radius: 6px; padding: 28px; }
  .tip-num { font-family: 'Fraunces', serif; font-size: 36px; font-weight: 400; color: rgba(42,36,32,0.12); margin-bottom: 12px; line-height: 1; }
  .tip-title { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 400; margin-bottom: 10px; line-height: 1.3; }
  .tip-text { font-size: 13px; color: #5c4a3a; line-height: 1.75; }

  @media (max-width: 768px) {
    .looks-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .tips-grid { grid-template-columns: 1fr; gap: 16px; }
    .banner { height: 340px; }
    .banner-content { left: 28px; }
    .trust-bar-inner { gap: 20px; }
  }
  @media (max-width: 480px) {
    .hero-content { bottom: 40px; }
    .section { padding: 48px 0; }
  }
</style>

<!-- HERO -->
<section class="hero">
  <img src={`${base}images/hero-main.jpg`} alt="Style Object — Quiet luxury Amazon finds" class="hero-img">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="hero-eyebrow">Amazon Finds • Quiet Luxury</p>
    <h1 class="hero-title">Looks Expensive.<br><em>Costs Less.</em></h1>
    <p class="hero-sub">Neutral summer wardrobe that looks designer — but everything is from Amazon</p>
    <a href={`${base}looks/`} class="hero-btn">Browse All Looks →</a>
    <p class="hero-trust">All products linked to Amazon • Ships with Prime</p>
  </div>
</section>

<!-- TRUST BAR -->
<div class="trust-bar">
  <div class="container trust-bar-inner">
    <span>✦ All from Amazon</span>
    <span>✦ Ships with Prime</span>
    <span>✦ Quiet Luxury Aesthetic</span>
    <span>✦ Updated Weekly</span>
  </div>
</div>

<!-- NEW IN -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="section-eyebrow">Just Added</p>
        <h2 class="section-title">New <em>In</em></h2>
      </div>
      <a href={`${base}looks/`} class="section-link">View All →</a>
    </div>
    <div class="looks-grid">
      {newIn.map(look => (
        <div class="look-card">
          <a href={look.amazon} class="look-card-img" target="_blank" rel="nofollow sponsored">
            <img src={`${base}${look.heroImage.replace(/^\//, '')}`} alt={look.title} loading="lazy">
          </a>
          <p class="look-card-cat">{look.category}</p>
          <a href={look.amazon} class="look-card-title" target="_blank" rel="nofollow sponsored">{look.title}</a>
          <p class="look-card-price">{look.price}</p>
          <a href={look.amazon} class="look-card-btn" target="_blank" rel="nofollow sponsored">Shop on Amazon →</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FEATURED COLLECTION BANNER -->
<div class="container">
  <div class="banner">
    <img src={`${base}images/hero-linen-vest-set.jpg`} alt="Beach Day Under $115">
    <div class="banner-overlay"></div>
    <div class="banner-content">
      <p class="banner-eyebrow">Featured Collection</p>
      <h2 class="banner-title">Beach Day<br><em>Under $115</em></h2>
      <p class="banner-sub">Five pieces. One perfect summer day. All from Amazon.</p>
      <a href={`${base}looks/?cat=dresses`} class="banner-btn">Shop the Look</a>
    </div>
  </div>
</div>

<!-- POPULAR THIS SUMMER -->
<section class="section" style="padding-top: 0;">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="section-eyebrow">Most Loved</p>
        <h2 class="section-title">Popular <em>This Summer</em></h2>
      </div>
      <a href={`${base}looks/`} class="section-link">View All →</a>
    </div>
    <div class="looks-grid">
      {LOOKS.slice(0, 6).map(look => (
        <div class="look-card">
          <a href={look.amazon} class="look-card-img" target="_blank" rel="nofollow sponsored">
            <img src={`${base}${look.heroImage.replace(/^\//, '')}`} alt={look.title} loading="lazy">
          </a>
          <p class="look-card-cat">{look.category}</p>
          <a href={look.amazon} class="look-card-title" target="_blank" rel="nofollow sponsored">{look.title}</a>
          <p class="look-card-price">{look.price}</p>
          <a href={look.amazon} class="look-card-btn" target="_blank" rel="nofollow sponsored">Shop on Amazon →</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- STYLE TIPS -->
<section class="tips-section">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="section-eyebrow">The Guide</p>
        <h2 class="section-title">Style <em>Tips</em></h2>
      </div>
    </div>
    <div class="tips-grid">
      <div class="tip-card">
        <div class="tip-num">01</div>
        <div class="tip-title">The Quiet Luxury Formula</div>
        <p class="tip-text">Neutral palette, natural fabrics, minimal accessories. One investment piece surrounded by simple basics. The formula that always looks expensive.</p>
      </div>
      <div class="tip-card">
        <div class="tip-num">02</div>
        <div class="tip-title">How to Style a Linen Set</div>
        <p class="tip-text">Wear it monochrome for the effortless look. Add a silk scarf on the bag, gold hoops, flat sandals. The proportions do everything — don't overthink it.</p>
      </div>
      <div class="tip-card">
        <div class="tip-num">03</div>
        <div class="tip-title">The Bag Rule</div>
        <p class="tip-text">One structured bag elevates any outfit. Straw for the beach, woven leather for evening, a mini satchel for work. Invest in shape, not logos.</p>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
```
