---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LOOKS } from '../data/looks.js';
const base = import.meta.env.BASE_URL;
const latestLooks = LOOKS.slice(0, 6);
---
<BaseLayout title="STYLE OBJECT" description="Quiet luxury fashion finds on Amazon. The look for less — looks expensive, found on Amazon.">
<style>
  .hero { padding: 80px 0 60px; text-align: center; }
  .hero-eyebrow { font-size: 11px; letter-spacing: 5px; text-transform: uppercase; color: #8a7464; margin-bottom: 24px; }
  .hero-title { font-family: 'Fraunces', serif; font-size: clamp(38px, 6vw, 72px); font-weight: 400; letter-spacing: -2px; line-height: 1; margin-bottom: 20px; }
  .hero-title em { font-style: italic; color: #5c4a3a; }
  .hero-subtitle { font-family: 'Fraunces', serif; font-style: italic; font-size: clamp(15px, 2vw, 19px); color: #5c4a3a; max-width: 480px; margin: 0 auto 40px; line-height: 1.5; }
  .hero-cta { display: inline-block; padding: 14px 36px; border: 1px solid #2a2420; color: #2a2420; text-decoration: none; font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; transition: all 0.2s; }
  .hero-cta:hover { background: #2a2420; color: #faf6ee; }
  .section-header { padding: 60px 0 36px; display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid rgba(42,36,32,0.1); margin-bottom: 40px; }
  .section-eyebrow { font-size: 11px; letter-spacing: 4px; text-transform: uppercase; color: #8a7464; margin-bottom: 8px; }
  .section-title { font-family: 'Fraunces', serif; font-size: clamp(24px, 3.5vw, 36px); font-weight: 400; letter-spacing: -0.5px; }
  .section-title em { font-style: italic; color: #5c4a3a; }
  .view-all { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #5c4a3a; text-decoration: none; white-space: nowrap; border-bottom: 1px solid #8a7464; padding-bottom: 2px; }
  .view-all:hover { color: #2a2420; border-color: #2a2420; }
  .looks-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; padding-bottom: 80px; }
  .look-card { text-decoration: none; color: inherit; display: block; }
  .look-card-image { aspect-ratio: 4/5; overflow: hidden; border-radius: 2px; background: #f5f0e8; margin-bottom: 16px; }
  .look-card-image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
  .look-card:hover .look-card-image img { transform: scale(1.04); }
  .look-card-category { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #8a7464; margin-bottom: 6px; }
  .look-card-title { font-family: 'Fraunces', serif; font-size: 17px; font-weight: 400; line-height: 1.3; margin-bottom: 6px; }
  .look-card-title em { font-style: italic; color: #5c4a3a; }
  .look-card-price { font-family: 'Fraunces', serif; font-size: 15px; color: #5c4a3a; }
  .manifesto { padding: 80px 0; background: #2a2420; color: #faf6ee; text-align: center; }
  .manifesto-eyebrow { font-size: 11px; letter-spacing: 5px; text-transform: uppercase; color: #8a7464; margin-bottom: 24px; }
  .manifesto-title { font-family: 'Fraunces', serif; font-size: clamp(28px, 4vw, 48px); font-weight: 400; letter-spacing: -1px; line-height: 1.15; max-width: 680px; margin: 0 auto 28px; }
  .manifesto-title em { font-style: italic; color: #c4a882; }
  .manifesto-text { font-size: 15px; color: rgba(250,246,238,0.7); max-width: 520px; margin: 0 auto; line-height: 1.8; }
  @media (max-width: 900px) { .looks-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
  @media (max-width: 560px) { .looks-grid { grid-template-columns: 1fr; gap: 32px; } .section-header { flex-direction: column; gap: 12px; } }
</style>

<section class="hero">
  <div class="container">
    <p class="hero-eyebrow">Summer 2026</p>
    <h1 class="hero-title">The Look<br><em>for Less</em></h1>
    <p class="hero-subtitle">Looks expensive. Found on Amazon. Quiet luxury, honest prices.</p>
    <a href={`${base}looks/`} class="hero-cta">Shop All Looks</a>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-header">
      <div>
        <p class="section-eyebrow">Latest</p>
        <h2 class="section-title">Recent <em>Finds</em></h2>
      </div>
      <a href={`${base}looks/`} class="view-all">View All →</a>
    </div>
    <div class="looks-grid">
      {latestLooks.map(look => (
        <a href={`${base}looks/${look.slug}/`} class="look-card">
          <div class="look-card-image">
            <img src={`${base}${look.heroImage.replace(/^\//, '')}`} alt={look.title} loading="lazy">
          </div>
          <p class="look-card-category">{look.category}</p>
          <h3 class="look-card-title">{look.title}</h3>
          <p class="look-card-price">{look.price}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="manifesto">
  <div class="container">
    <p class="manifesto-eyebrow">The Edit</p>
    <h2 class="manifesto-title">Everything here <em>looks expensive.</em> None of it is.</h2>
    <p class="manifesto-text">Quiet luxury doesn't require a designer budget. It requires the right proportions, the right palette, and knowing where to look. That's what this is.</p>
  </div>
</section>
</BaseLayout>
