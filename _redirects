# === Root redirects ===
/looks/                  /looks/index.html          200
/looks                   /looks/index.html          200

# === Individual Look pages (Pretty URLs) ===
/looks/:slug             /looks/look.html?slug=:slug 200

# === Static assets (data, images и т.д.) ===
/looks/data/*            /looks/data/:splat         200

# === Fallback for everything else in /looks/ ===
/looks/*                 /looks/look.html           200
