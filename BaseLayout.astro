---
const { title, description, activeCategory = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — STYLE OBJECT</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={Astro.url.href}>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JHWC41ZE4V"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JHWC41ZE4V');
  </script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #faf6ee; color: #2a2420; line-height: 1.6; font-weight: 300; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .header { padding: 20px 0; border-bottom: 1px solid rgba(42,36,32,0.1); background: #faf6ee; position: sticky; top: 0; z-index: 100; }
    .header-inner { display: flex; justify-content: space-between; align-items: center; }
    .logo { font-family: 'Fraunces', serif; font-size: 21px; font-weight: 400; letter-spacing: 4px; color: #2a2420; text-decoration: none; }
    .nav { display: flex; gap: 0; }
    .nav a { color: #5c4a3a; text-decoration: none; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; transition: color 0.2s; padding: 6px 12px; border-radius: 2px; }
    .nav a:hover { color: #2a2420; }
    .nav a.active { color: #2a2420; background: rgba(42,36,32,0.07); }
    .footer { padding: 48px 0 32px; text-align: center; background: #2a2420; color: #faf6ee; }
    .footer-logo { font-family: 'Fraunces', serif; font-size: 22px; letter-spacing: 4px; margin-bottom: 16px; }
    .footer-links { display: flex; gap: 16px; justify-content: center; margin-bottom: 24px; flex-wrap: wrap; }
    .footer-links a { color: #faf6ee; text-decoration: none; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; opacity: 0.7; transition: opacity 0.2s; }
    .footer-links a:hover { opacity: 1; }
    .footer-copy { font-size: 11px; color: #8a7464; letter-spacing: 1px; }
    .disclosure { padding: 28px 24px; text-align: center; font-size: 12px; color: #8a7464; font-style: italic; border-top: 1px solid rgba(42,36,32,0.1); }
    @media (max-width: 768px) {
      .nav a { font-size: 10px; padding: 5px 8px; letter-spacing: 0.5px; }
      .logo { font-size: 17px; letter-spacing: 3px; }
    }
    @media (max-width: 480px) {
      .nav { flex-wrap: wrap; justify-content: flex-end; gap: 2px; }
      .nav a { font-size: 9px; padding: 4px 7px; }
    }
  </style>
</head>
<body>
<header class="header">
  <div class="container header-inner">
    <a href={`${base}`} class="logo">STYLE · OBJECT</a>
    <nav class="nav">
      <a href={`${base}looks/`} class={activeCategory === 'all' ? 'active' : ''}>All</a>
      <a href={`${base}looks/?cat=bags`} class={activeCategory === 'bags' ? 'active' : ''}>Bags</a>
      <a href={`${base}looks/?cat=shoes`} class={activeCategory === 'shoes' ? 'active' : ''}>Shoes</a>
      <a href={`${base}looks/?cat=dresses`} class={activeCategory === 'dresses' ? 'active' : ''}>Dresses</a>
      <a href={`${base}looks/?cat=accessories`} class={activeCategory === 'accessories' ? 'active' : ''}>Accessories</a>
    </nav>
  </div>
</header>

<slot />

<div class="disclosure">
  <div class="container">
    This page contains affiliate links. As an Amazon Associate I earn from qualifying purchases. This does not affect the price you pay.
  </div>
</div>

<footer class="footer">
  <div class="container">
    <div class="footer-logo">STYLE · OBJECT</div>
    <div class="footer-links">
      <a href={`${base}looks/`}>All Looks</a>
      <a href={`${base}looks/?cat=bags`}>Bags</a>
      <a href={`${base}looks/?cat=shoes`}>Shoes</a>
      <a href={`${base}looks/?cat=dresses`}>Dresses</a>
      <a href={`${base}looks/?cat=accessories`}>Accessories</a>
    </div>
    <div class="footer-copy">© 2025 Style Object. All rights reserved.</div>
  </div>
</footer>
</body>
</html>
